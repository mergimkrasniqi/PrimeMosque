rules_version = '2';

// Access model:
// - Imams: the 8-character board code is the shared secret — anyone who
//   knows it (it is only shown on the TV's own settings screen) can read
//   and manage that ONE board. Codes are random over a 32-character
//   alphabet (32^8 ≈ 10^12), so they are not guessable in practice.
// - Admin: the Google account(s) below can additionally LIST all boards
//   (the dashboard) and delete boards.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['mkrasniqi571@gmail.com'];
    }

    match /boards/{code} {
      allow get: if code.matches('^[A-HJ-NP-Z2-9]{6,8}$') || isAdmin();
      allow list: if isAdmin();
      allow create, update: if
        (code.matches('^[A-HJ-NP-Z2-9]{6,8}$') || isAdmin())
        // Only the fields the app understands can be written.
        && request.resource.data.keys().hasOnly([
             'mosqueName', 'place', 'city', 'language', 'secondaryLanguage',
             'orientation', 'theme', 'themeRotation', 'nightMode',
             'showDailyQuotes', 'ramadanMode',
             'announcement1', 'announcement2',
             'announcement1Until', 'announcement2Until',
             'lectureTitle', 'lectureDay', 'lecturePrayer',
             'jumuahMinutes', 'khutbahMinutes', 'hijriOffset',
             'adhanSequence', 'preAdhanMinutes', 'adhanDuaSeconds',
             'adhanSeconds',
             'adjustments', 'dailyQuotes', 'khutbahQuotes',
             'heartbeat', 'boardTimeEpochMs', 'clockSynced', 'appVersion',
           ]);
      allow delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
